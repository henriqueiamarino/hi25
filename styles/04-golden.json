{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"title": "Golden",
	"slug": "golden",
	"settings": {
		"color": {
			"palette": [
				{
					"color": "#fafafa",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#D2B579",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#080808",
					"name": "Primary",
					"slug": "primary"
				},
				{
					"color": "#030303",
					"name": "Secondary",
					"slug": "secondary"
				},
				{
					"color": "#0303031a",
					"name": "Tertiary",
					"slug": "tertiary"
				},
				{
					"color": "#f2f3f4",
					"name": "Quaternary",
					"slug": "quaternary"
				}
			]
		}
	},
	"styles": {
		"blocks": {
			"core/avatar": {
				"filter": {
					"duotone": "var(--wp--preset--duotone--duo-golden)"
				}
			},
			"core/cover": {
				"filter": {
					"duotone": "var(--wp--preset--duotone--duo-golden)"
				}
			},
			"core/post-author": {
				"filter": {
					"duotone": "var(--wp--preset--duotone--duo-golden)"
				}
			},
			"core/post-featured-image": {
				"filter": {
					"duotone": "var(--wp--preset--duotone--duo-golden)"
				}
			}
		}
	}
}
